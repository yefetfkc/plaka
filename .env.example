# Copy to .env and fill in. Never commit the real .env file.
PORT=3000
# Long random string (at least 32 characters), e.g. `openssl rand -hex 32`
SECRET_KEY=
# Username that gets access to the admin panel
ADMIN_USERNAME=
# Public origin of the app, e.g. https://plates.example.com
ALLOWED_ORIGIN=
# Nightly backups are written here inside the container (mounted from ./yedekler)
BACKUP_DIR=/app/yedekler
# How many days of backups to keep
BACKUP_KEEP_DAYS=14
